GameState="*res://autoloads/game_state.gd"
SaveManager="*res://autoloads/save_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Dungeon Danger"

[editor]

